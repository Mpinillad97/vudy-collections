generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Our own record of a Payment Request created through Vudy. Standalone for
// now — no Customer/Invoice relations, those are out of scope for M1.2.
model PaymentRequest {
  id             String   @id @default(cuid())
  vudyRequestId  String   @unique
  vudyUrl        String
  vudyEmbedUrl   String
  targetAddress  String
  amount         Decimal  @db.Decimal(18, 6)
  currencyToken  String
  requestedChain String
  requestedToken String
  customId       String?
  note           String?
  createdAt      DateTime @default(now())
}

// First piece of the commercial domain (Customer -> Invoice -> Payment
// Request). Standalone for now — no Invoice/PaymentRequest relations yet,
// those are out of scope for M2.1. Email is intentionally not @unique: the
// assessment doesn't establish email as Customer's unique identity.
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  createdAt DateTime @default(now())
}
