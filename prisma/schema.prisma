generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Our own record of a Payment Request created through Vudy. Standalone for
// now — no Customer/Invoice relations, those are out of scope for M1.2.
model PaymentRequest {
  id             String   @id @default(cuid())
  vudyRequestId  String   @unique
  vudyUrl        String
  vudyEmbedUrl   String
  targetAddress  String
  amount         Decimal  @db.Decimal(18, 6)
  currencyToken  String
  requestedChain String
  requestedToken String
  customId       String?
  note           String?
  createdAt      DateTime @default(now())
}

// Second piece of the commercial domain (Customer -> Invoice -> Payment
// Request). Email is intentionally not @unique: the assessment doesn't
// establish email as Customer's unique identity.
model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  createdAt DateTime  @default(now())
  invoices  Invoice[]
}

// Belongs to a Customer. Does not yet connect to PaymentRequest/Vudy —
// that's out of scope for M2.2. Amount uses the same Decimal(18,6) +
// number-at-the-DTO-boundary approach as PaymentRequest.amount, for
// consistency; a stricter money strategy (e.g. string-based amounts) can
// be evaluated later, but is not implemented now.
model Invoice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  number     String
  amount     Decimal  @db.Decimal(18, 6)
  currency   String
  dueDate    DateTime
  createdAt  DateTime @default(now())
}
