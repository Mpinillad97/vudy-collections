generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Our own record of a Payment Request created through Vudy. Optionally
// linked to the Invoice it was generated from (M2.3) — invoiceId is
// nullable because PaymentRequests created via the original M1.2 flow
// (POST /payment-requests, /vudy/payment-requests/test) have no Invoice.
// @unique on invoiceId enforces Invoice 1 -> 0..1 PaymentRequest at the DB
// level: a given Invoice can never have more than one local PaymentRequest.
model PaymentRequest {
  id             String   @id @default(cuid())
  vudyRequestId  String   @unique
  vudyUrl        String
  vudyEmbedUrl   String
  targetAddress  String
  amount         Decimal  @db.Decimal(18, 6)
  currencyToken  String
  requestedChain String
  requestedToken String
  // Last known lifecycle status from Vudy ("pending"/"completed", verbatim —
  // never inferred locally), written only as a direct overwrite from an
  // explicit GET /channel/vudy/request/{vudyRequestId} check. Null means
  // "never checked yet", distinct from "pending".
  status         String?
  customId       String?
  note           String?
  createdAt      DateTime @default(now())
  invoiceId      String?  @unique
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
}

// Second piece of the commercial domain (Customer -> Invoice -> Payment
// Request). Email is intentionally not @unique: the assessment doesn't
// establish email as Customer's unique identity.
model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  createdAt DateTime  @default(now())
  invoices  Invoice[]
}

// Belongs to a Customer. Optionally linked to the PaymentRequest generated
// from it (M2.3) — a Payment Request creation/settlement/status machine is
// still out of scope. Amount uses the same Decimal(18,6) +
// number-at-the-DTO-boundary approach as PaymentRequest.amount, for
// consistency; a stricter money strategy (e.g. string-based amounts) can
// be evaluated later, but is not implemented now.
model Invoice {
  id             String          @id @default(cuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  number         String
  amount         Decimal         @db.Decimal(18, 6)
  currency       String
  dueDate        DateTime
  createdAt      DateTime        @default(now())
  paymentRequest PaymentRequest?
}
